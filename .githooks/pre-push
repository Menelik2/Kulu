#!/usr/bin/env bash
# KULU pre-push: typecheck before pushing to remote
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ ! -d node_modules ]; then
  echo "⚠️  node_modules missing — skip pre-push checks (run npm install)."
  exit 0
fi

echo "→ pre-push: typecheck…"
npm run typecheck

# Uncomment for stricter CI-like local gate:
# echo "→ pre-push: production build…"
# npm run build

exit 0
